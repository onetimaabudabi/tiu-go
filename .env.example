# Шаблон настроек TIU GO. Скопируйте в .env и заполните:
#
#   cp .env.example .env
#
# ВАЖНО: ЭТОТ ФАЙЛ ЛЕЖИТ В ПУБЛИЧНОМ РЕПОЗИТОРИИ НА GITHUB.
#
# Всё, что вписано сюда, видно всему интернету — и остаётся видно
# в истории коммитов даже после удаления.
#
# Приложение этот файл НЕ ЧИТАЕТ. Оно читает .env, которого в репозитории
# нет (он в .gitignore). Настоящим токенам, паролям и ключам место
# ТОЛЬКО в .env. Здесь — пустые значения и комментарии.

PORT=3000
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
WEBAPP_URL=https://www.tiugo.ru

# Админ-панель (/admin): статусы лифтов, статистика, рассылка.
#
# Пока обе переменные ниже не заданы, админки не существует: и страница,
# и все ручки /api/admin отвечают 404. Пароль придумайте свой и впишите
# его в .env — с этой страницы рассылаются сообщения всем пользователям.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Жёсткий выключатель поверх пароля: ADMIN_ENABLED=false убирает админку
# совсем, даже если логин с паролем заданы. Удобно для боевого сервера.
# Любое другое значение (или отсутствие строки) ничего не запрещает.
ADMIN_ENABLED=true

# ───────────────────────────────────────────────────────────────
# База данных (Upstash Redis)
#
# Здесь живут пользователи ботов, счётчики обращений к API и статусы
# лифтов. Без неё всё это держится в памяти процесса: пропадает при
# рестарте и не видно другим сервисам — а на Render сервер и боты
# развёрнуты по отдельности, у каждого свой диск.
#
# Где взять: upstash.com -> Create Database -> вкладка REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Проверка TLS-сертификата MAX. Сейчас она отключена (см. shared/max-api.js):
# это значит, что соединение можно подменить по дороге. Когда появится
# возможность проверить, поставьте true и уберите отключение в коде.
MAX_STRICT_TLS=false

# Канал проекта: ссылку открывает иконка в шапке мини-аппа и кнопка
# в настройках. Не задана — обе кнопки просто не показываются.
TELEGRAM_CHANNEL_URL=https://t.me/tiu_go
