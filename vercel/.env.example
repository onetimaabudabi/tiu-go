# ───────────────────────────────────────────────────────────────
# TIU GO — переменные окружения serverless-версии
#
# Локально: скопируйте в vercel/.env
# На Vercel: Settings → Environment Variables, те же имена
# ───────────────────────────────────────────────────────────────

# Боты. Без токена уведомления просто не отправляются, всё остальное работает.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=

# Адрес мини-приложения — его бот подставляет в кнопку.
# После подключения домена: https://app.tiu.go.ru
WEBAPP_URL=https://tiu-go.vercel.app

# Канал проекта: иконка в шапке, карточка в настройках и экран «О проекте».
# Не задан — все три просто не показываются.
TELEGRAM_CHANNEL_URL=https://t.me/tiu_go_news

# Админка. По умолчанию выключена: это инструмент демонстрации,
# и в интернете открывать его без нужды не стоит.
ADMIN_ENABLED=false

# ───────────────────────────────────────────────────────────────
# Хранилище состояния (Vercel KV / Upstash Redis)
#
# Vercel подставляет эти переменные сам, когда база подключена к проекту:
# Storage → Create Database → KV. Руками их заполнять нужно только
# для локального запуска.
#
# Переменных нет — приложение работает, но состояние живёт в памяти
# инстанса и пропадает при холодном старте. Для демонстрации терпимо,
# для подписок на уведомления — нет.
# ───────────────────────────────────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Секреты вебхуков. Необязательны, но без них на адрес бота может
# писать кто угодно. Telegram передаёт свой в заголовке
# X-Telegram-Bot-Api-Secret-Token — он задаётся при setWebhook.
TELEGRAM_WEBHOOK_SECRET=
MAX_WEBHOOK_SECRET=

# Базовый адрес API MAX. Меняется только если он отличается от значения
# по умолчанию — см. https://dev.max.ru/docs
MAX_API_BASE=

# Защита ручки рассылки от посторонних вызовов. Vercel присылает этот
# секрет в заголовке Authorization при запуске по расписанию.
CRON_SECRET=
